            <div>
              <div class="info-k">Location</div>
              <div class="info-v">Sri Lanka — open to remote</div>
            </div>
          </div>
          <div class="info-row">
            <div class="info-ico"><i class="fas fa-clock" aria-hidden="true"></i></div>
            <div>
              <div class="info-k">Response time</div>
              <div class="info-v">Usually within 24 hours</div>
            </div>
          </div>
        </div>

        <div class="socials">
          <span class="socials-label">Connect</span>
          <a href="https://github.com/aushadhini" class="soc" target="_blank" rel="noopener" aria-label="GitHub">
            <i class="fab fa-github" aria-hidden="true"></i>
          </a>
          <a href="https://www.linkedin.com/in/niragi-kodagoda-8b40b3288/" class="soc" target="_blank" rel="noopener" aria-label="LinkedIn">
            <i class="fab fa-linkedin-in" aria-hidden="true"></i>
          </a>
          <a href="https://x.com/aushadhini" class="soc" target="_blank" rel="noopener" aria-label="X">
            <i class="fab fa-x-twitter" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!--
        FORMSPREE SETUP — one step before this form works:
        1. Sign up free at https://formspree.io and create a new form.
        2. Copy the form's endpoint ID (looks like "xvojqbdk").
        3. Replace YOUR_FORM_ID in the action attribute below.
        Until you do, submitting shows an error instead of silently losing the message.
      -->
      <form class="form reveal" id="contactForm" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
        <h3>Send a message</h3>

        <div class="field-row">
          <div class="field">
            <label for="cf-name">Name</label>
            <input class="input" type="text" id="cf-name" name="name" placeholder="Your name" required autocomplete="name">
          </div>
          <div class="field">
            <label for="cf-email">Email</label>
            <input class="input" type="email" id="cf-email" name="email" placeholder="you@example.com" required autocomplete="email">
          </div>
        </div>

        <div class="field">
          <label for="cf-subject">Subject</label>
          <input class="input" type="text" id="cf-subject" name="subject" placeholder="What is this about?" required>
        </div>

        <div class="field">
          <label for="cf-message">Message</label>
          <textarea class="input" id="cf-message" name="message" rows="5" placeholder="Tell me about the role or project…" required></textarea>
        </div>

        <!-- honeypot: bots fill this, humans never see it -->
        <div class="hp" aria-hidden="true">
          <label for="cf-hp">Leave this field empty</label>
          <input type="text" id="cf-hp" name="_gotcha" tabindex="-1" autocomplete="off">
        </div>

        <button type="submit" class="btn btn-primary btn-block" id="cfSubmit">
          <i class="fas fa-paper-plane" aria-hidden="true"></i> Send message
        </button>

        <p class="form-status" id="cfStatus" role="status" aria-live="polite"></p>
        <p class="form-note">Or email me directly at niragiaushadhini@gmail.com</p>
      </form>
    </div>
  </div>
</section>

