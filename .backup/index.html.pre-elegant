<!-- ══ EXPERTISE ════════════════════════════════════════════ -->
<section class="section" id="expertise">
  <div class="wrap">
    <div class="sec-head sec-head--center reveal">
      <span class="eyebrow">Expertise</span>
      <h2 class="sec-title">What I bring to a <em>team</em></h2>
      <p class="sec-sub">Quality assurance is the core. Development is the context that makes it sharper.</p>
    </div>

    <div class="cards reveal-group">
      <article class="card">
        <span class="card-num">01</span>
        <div class="card-ico"><i class="fas fa-clipboard-check" aria-hidden="true"></i></div>
        <h3>Manual &amp; Functional Testing</h3>
        <p>
          Verifying that features behave as specified across browsers, screen sizes, and user flows.
          Exploratory testing to surface the issues scripted cases miss, plus regression passes before release.
        </p>
        <div class="tags">
          <span class="tag">Functional</span>
          <span class="tag">Exploratory</span>
          <span class="tag">Regression</span>
          <span class="tag">Cross-browser</span>
        </div>
      </article>

      <article class="card">
        <span class="card-num">02</span>
        <div class="card-ico"><i class="fas fa-list-check" aria-hidden="true"></i></div>
        <h3>Test Case Design &amp; Documentation</h3>
        <p>
          Turning requirements into structured, traceable test cases with clear preconditions,
          steps, and expected results — so coverage is visible and anyone on the team can run them.
        </p>
        <div class="tags">
          <span class="tag">Test cases</span>
          <span class="tag">Traceability</span>
          <span class="tag">Edge cases</span>
          <span class="tag">SDLC / STLC</span>
        </div>
      </article>

      <article class="card">
        <span class="card-num">03</span>
        <div class="card-ico"><i class="fas fa-bug" aria-hidden="true"></i></div>
        <h3>Defect Tracking &amp; Reporting</h3>
        <p>
          Reproducing issues reliably, isolating root cause where I can, and writing reports with
          the severity, environment, and evidence a developer needs to fix it on the first attempt.
        </p>
        <div class="tags">
          <span class="tag">Reproduction</span>
          <span class="tag">Severity triage</span>
          <span class="tag">Root cause</span>
          <span class="tag">Retesting</span>
        </div>
      </article>

      <article class="card">
        <span class="card-num">04</span>
        <div class="card-ico"><i class="fas fa-laptop-code" aria-hidden="true"></i></div>
        <h3>Development Background</h3>
        <p>
          Client-facing frontend and UI/UX work delivered during my internship at Arimac. I read
          the codebase, understand the architecture, and test knowing where the fragile seams are.
        </p>
        <div class="tags">
          <span class="tag">React</span>
          <span class="tag">JavaScript</span>
          <span class="tag">Spring Boot</span>
          <span class="tag">Figma</span>
        </div>
      </article>
    </div>
  </div>
</section>

