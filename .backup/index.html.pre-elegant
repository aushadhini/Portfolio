<!-- ══ PROCESS ══════════════════════════════════════════════ -->
<section class="section" id="process">
  <div class="wrap">
    <div class="sec-head sec-head--center reveal">
      <span class="eyebrow">Process</span>
      <h2 class="sec-title">How I approach <em>testing</em></h2>
      <p class="sec-sub">A repeatable loop, so coverage is deliberate rather than accidental.</p>
    </div>

    <div class="steps reveal-group">
      <article class="step">
        <div class="step-n">01</div>
        <h3>Analyse</h3>
        <p>Read the requirements and clarify intended behaviour before writing a single test — including what <em>should not</em> happen.</p>
      </article>
      <article class="step">
        <div class="step-n">02</div>
        <h3>Design</h3>
        <p>Build test cases covering happy paths, boundaries, and negative scenarios, each with clear steps and expected results.</p>
      </article>
      <article class="step">
        <div class="step-n">03</div>
        <h3>Execute</h3>
        <p>Run the suite, then explore beyond it. Log every defect with reproduction steps, environment, and evidence.</p>
      </article>
      <article class="step">
        <div class="step-n">04</div>
        <h3>Verify</h3>
        <p>Retest fixes, run regression around the change, and confirm nothing adjacent broke on the way to green.</p>
      </article>
    </div>
  </div>
</section>

<!-- ══ PROJECTS ═════════════════════════════════════════════ -->
<section class="section section--sub section--bordered" id="projects">
  <div class="wrap">
