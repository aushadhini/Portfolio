/* ═══════════════════════════════════════════════════════════════
   Niragi Kodagoda — Portfolio
   ───────────────────────────────────────────────────────────────
   "Verified Jade" — deep jade on warm stone.
   Jade is the primary accent AND the pass state: for a QA
   engineer the palette carries the meaning of the work.

   Type    editorial serif display / neutral sans / mono labels
   Surface hairline borders and background steps, not shadows
   Radii   sharp (3-8px) — precision instrument, not soft SaaS card
   ═══════════════════════════════════════════════════════════════ */

/* ── TOKENS · LIGHT ─────────────────────────────────────────── */
:root {
  /* Surfaces — warm off-whites rather than clinical pure white */
  --bg:            #fcfbf9;
  --bg-sub:        #f6f4f0;
  --surface:       #ffffff;
  --surface-2:     #f1eee9;
  --border:        #e6e1d8;
  --border-strong: #d4cec1;

  /* Warm near-black instead of blue-grey */
  --fg:            #1c1a17;
  --fg-2:          #57534e;
  --fg-3:          #706a64;

  /* Deep jade — distinct from default SaaS blue, and green reads as "pass" */
  --accent:        #0d6e63;
  --accent-hover:  #0a574e;
  --accent-fg:     #ffffff;
  --accent-soft:   rgba(13, 110, 99, 0.07);
  --accent-line:   rgba(13, 110, 99, 0.22);
  --pass:          #14793a;
  --danger:        #b91c1c;
  --danger-soft:   rgba(185, 28, 28, 0.07);
  --danger-line:   rgba(185, 28, 28, 0.26);

  /* Ochre — second discipline only (UI/UX), never decoration */
  --accent-2:      #9a5d0a;
  --accent-2-soft: rgba(154, 93, 10, 0.08);
  --accent-2-line: rgba(154, 93, 10, 0.24);
  --arch-fill:     #e6ece8;

  --shadow-sm: 0 1px 2px rgba(28, 26, 23, 0.05);
  --shadow:    0 4px 16px -4px rgba(28, 26, 23, 0.10);
  --shadow-lg: 0 18px 50px -14px rgba(28, 26, 23, 0.18);

  --font-display: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
  --font-sans:    'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
  --font-mono:    'JetBrains Mono', ui-monospace, 'SFMono-Regular', monospace;

  --r-sm:   4px;
  --r:      8px;
  --r-lg:   14px;
  --r-full: 999px;

  --ease: cubic-bezier(0.4, 0, 0.2, 1);
  --nav-h: 76px;
}

/* ── TOKENS · DARK ──────────────────────────────────────────── */
html[data-theme='dark'] {
  /* Warm charcoals — avoids the flat blue-black of the default dark theme */
  --bg:            #12110f;
  --bg-sub:        #171512;
  --surface:       #1d1b18;
  --surface-2:     #24211d;
  --border:        #302c27;
  --border-strong: #454039;

  --fg:            #f8f7f4;
  --fg-2:          #a8a29a;
  --fg-3:          #8f8980;

  --accent:        #4fd1c5;
  --accent-hover:  #7ee0d7;
  --accent-fg:     #10201e;
  --accent-soft:   rgba(79, 209, 197, 0.12);
  --accent-line:   rgba(79, 209, 197, 0.30);
  --pass:          #4ade80;
  --danger:        #fca5a5;
  --danger-soft:   rgba(252, 165, 165, 0.09);
  --danger-line:   rgba(252, 165, 165, 0.26);

  --accent-2:      #f0b429;
  --accent-2-soft: rgba(240, 180, 41, 0.13);
  --accent-2-line: rgba(240, 180, 41, 0.30);
  --arch-fill:     #e6ece8;

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.45);
  --shadow:    0 4px 16px -4px rgba(0, 0, 0, 0.55);
  --shadow-lg: 0 18px 50px -14px rgba(0, 0, 0, 0.7);
}

/* ── RESET ──────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--nav-h) + 24px);
  -webkit-text-size-adjust: 100%;
}

html { background: var(--bg); }

body {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  color: var(--fg);
  background: var(--bg);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  counter-reset: sec;
}

img, svg { display: block; max-width: 100%; height: auto; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; background: none; border: none; cursor: pointer; }
input, textarea, select { font: inherit; color: inherit; }
ul, ol { list-style: none; }

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 2px;
}

::selection { background: var(--accent); color: var(--accent-fg); }

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border-strong); border: 3px solid var(--bg); border-radius: var(--r-full); }
::-webkit-scrollbar-thumb:hover { background: var(--fg-3); }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ── FRAMED CANVAS ──────────────────────────────────────────────
   The whole document sits as an inset cream card on the forest
   ground, so the frame reads as a deliberate margin at every
   scroll position. Dropped to full-bleed on phones where the
   horizontal space is worth more than the framing.
   ─────────────────────────────────────────────────────────────── */

@media (max-width: 640px) {
  :root { --frame: 0px; --r-canvas: 0px; }
}

/* ── ACCESSIBILITY HELPERS ──────────────────────────────────── */
.sr-only {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
}

.skip {
  position: absolute; top: 8px; left: 8px; z-index: 2000;
  padding: 10px 18px; border-radius: var(--r);
  background: var(--accent); color: var(--accent-fg);
  font-size: 0.875rem; font-weight: 600;
  transform: translateY(-200%);
  transition: transform 0.2s var(--ease);
}
.skip:focus { transform: translateY(0); }

/* ── TYPE SYSTEM ────────────────────────────────────────────────
   Bold geometric sans for statements, Inter for reading, and mono
   kept only for genuinely code-adjacent data (stack chips, badges).
   ─────────────────────────────────────────────────────────────── */
h1, h2, h3, h4, .display, .sec-title {
  font-family: var(--font-display);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.03em;
  text-wrap: balance;
}
h3, h4 { font-weight: 700; letter-spacing: -0.02em; line-height: 1.28; }

/* letterspaced sans caps, prefixed with an auto section index */
.eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  font-family: var(--font-display);
  font-size: 0.6875rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--fg-3);
}
.eyebrow::before {
  content: counter(sec, decimal-leading-zero);
  color: var(--accent);
}
.eyebrow::after {
  content: '';
  width: 26px; height: 2px;
  background: var(--accent);
  opacity: 0.45;
}

/* ── LAYOUT ─────────────────────────────────────────────────── */
.wrap { width: 100%; max-width: 1280px; margin: 0 auto; padding: 0 40px; }

.section { padding: 128px 0; position: relative; counter-increment: sec; }
.section--sub { background: var(--bg-sub); }
.section--bordered { border-block: 1px solid var(--border); }

.sec-head { max-width: 680px; margin-bottom: 76px; }
.sec-head--center { margin-inline: auto; text-align: center; }
.sec-head--center .eyebrow { justify-content: center; }

.sec-title {
  font-size: clamp(2.25rem, 4.6vw, 3.25rem);
  margin: 20px 0 0;
}
/* the accented word */
.sec-title em, .hero h1 em, .hero-statement em {
  font-style: normal;
  color: var(--accent);
}
.sec-sub {
  margin-top: 20px;
  font-size: 1.0625rem;
  color: var(--fg-2);
  max-width: 56ch;
  text-wrap: pretty;
}
.sec-head--center .sec-sub { margin-inline: auto; }

/* ── BUTTONS ────────────────────────────────────────────────── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  padding: 15px 26px;
  border-radius: var(--r-sm);
  font-family: var(--font-display);
  font-size: 0.75rem; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  white-space: nowrap;
  border: 1px solid transparent;
  transition: background 0.18s var(--ease), border-color 0.18s var(--ease),
              color 0.18s var(--ease), transform 0.18s var(--ease);
}
.btn i { font-size: 0.8125em; }
.btn:active { transform: translateY(1px); }

.btn-primary { background: var(--accent); color: var(--accent-fg); }
.btn-primary:hover { background: var(--accent-hover); }

.btn-ghost { background: transparent; color: var(--fg); border-color: var(--border-strong); }
.btn-ghost:hover { border-color: var(--fg-3); background: var(--surface-2); }

.btn-block { width: 100%; }

/* text button with a coral rule under it, as in the reference */
.btn-underline:hover { color: var(--accent); }

/* ── NAV ────────────────────────────────────────────────────── */
.nav {
  position: fixed; z-index: 1000;
  top: 0; left: 0; right: 0;
  height: var(--nav-h);
  border-bottom: 1px solid transparent;
  transition: background 0.25s var(--ease), border-color 0.25s var(--ease);
}
.nav.is-scrolled {
  background: color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter: saturate(180%) blur(18px);
  -webkit-backdrop-filter: saturate(180%) blur(18px);
  border-bottom-color: var(--border);
}


.nav-in { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }

.brand {
  font-family: var(--font-display);
  font-size: 1rem; font-weight: 800;
  letter-spacing: 0.16em; text-transform: uppercase;
  display: inline-flex; align-items: baseline;
}
.brand em { color: var(--accent); font-style: normal; }

.nav-menu { display: flex; align-items: center; gap: 2px; }
.nav-menu a {
  position: relative;
  display: block;
  padding: 8px 13px;
  font-family: var(--font-display);
  font-size: 0.6875rem; font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--fg-2);
  transition: color 0.18s var(--ease);
}
.nav-menu a:hover { color: var(--fg); }
.nav-menu a.is-active { color: var(--fg); }
.nav-menu a.is-active::after {
  content: ''; position: absolute; left: 13px; right: 13px; bottom: 0;
  height: 2px; background: var(--accent);
}

.nav-right { display: flex; align-items: center; gap: 10px; }

.icon-btn {
  display: grid; place-items: center;
  width: 36px; height: 36px;
  border-radius: var(--r);
  border: 1px solid var(--border);
  background: transparent;
  color: var(--fg-3);
  font-size: 0.8125rem;
  transition: color 0.18s var(--ease), border-color 0.18s var(--ease);
}
.icon-btn:hover { color: var(--fg); border-color: var(--border-strong); }

.nav-cta { padding: 10px 18px; font-size: 0.8125rem; }

.burger { display: none; }

/* ── HERO ───────────────────────────────────────────────────────
   Three columns: statement / arch portrait / capability rail.
   ─────────────────────────────────────────────────────────────── */
.hero { position: relative; padding: calc(var(--nav-h) + 56px) 0 64px; }

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.82fr);
  gap: 72px;
  align-items: center;
}
.hero-copy { min-width: 0; }

.hero-eyebrow {
  font-family: var(--font-display);
  font-size: 0.6875rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--pass);
}

.hero h1 {
  margin: 18px 0 0;
  font-size: clamp(2.5rem, 4.2vw, 3.5rem);
  letter-spacing: -0.04em;
}


.hero-lede {
  margin-top: 18px;
  max-width: 40ch;
  font-size: 0.9375rem;
  color: var(--fg-2);
  line-height: 1.7;
  text-wrap: pretty;
}

.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 32px; }


/* status pill */
.status-dot {
  position: relative;
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--pass); flex: none;
}
.status-dot::after {
  content: ''; position: absolute; inset: -3px;
  border-radius: 50%; border: 1px solid var(--pass);
  opacity: 0; animation: ping 2.6s var(--ease) infinite;
}
@keyframes ping {
  0%   { opacity: 0.6; transform: scale(0.6); }
  70%  { opacity: 0;   transform: scale(1.6); }
  100% { opacity: 0;   transform: scale(1.6); }
}

/* ── ARCH PORTRAIT ──────────────────────────────────────────── */
.hero-media { position: relative; display: flex; justify-content: center; }

/* The reference used a cut-out portrait so the sage showed through.
   This is a white-background studio JPEG, so multiply maps its white
   ground onto the sage while leaving the (dark) subject intact. */

/* the overlapping coral disc from the reference */

/* ── CAPABILITY RAIL ────────────────────────────────────────── */
.hero-rail { min-width: 0; }




.socials { display: flex; align-items: center; gap: 10px; margin-top: 26px; }
.socials-label {
  font-family: var(--font-display);
  font-size: 0.625rem; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--fg-3);
  margin-right: 6px;
}
.soc {
  display: grid; place-items: center;
  width: 36px; height: 36px;
  border-radius: var(--r-sm);
  background: var(--fg);
  color: var(--bg);
  font-size: 0.875rem;
  transition: background 0.18s var(--ease), transform 0.18s var(--ease);
}
.soc:hover { background: var(--accent); transform: translateY(-2px); }

/* ── STAT BOXES ─────────────────────────────────────────────── */

/* ── ABOUT ──────────────────────────────────────────────────── */
.about-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 72px;
  align-items: start;
}
.prose p { color: var(--fg-2); font-size: 1.0625rem; text-wrap: pretty; }
.prose p + p { margin-top: 20px; }
.prose strong { color: var(--fg); font-weight: 600; }

.pillars { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--border); }
.pillar {
  padding: 28px 24px;
  background: var(--bg);
  transition: background 0.2s var(--ease);
}
.section--sub .pillar { background: var(--bg-sub); }
.pillar:hover { background: var(--surface); }
.pillar-ico { color: var(--accent); font-size: 1rem; margin-bottom: 18px; }
.pillar h3 { font-size: 0.9375rem; }
.pillar p { margin-top: 10px; font-size: 0.875rem; color: var(--fg-2); line-height: 1.6; }

.facts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--border); }
.fact {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 13px;
  border: 1px solid var(--border);
  border-radius: var(--r-full);
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  color: var(--fg-2);
}
.fact i { font-size: 0.6875rem; color: var(--fg-3); }
.fact--live i { color: var(--pass); }

.about-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

/* ── EXPERTISE CARDS ────────────────────────────────────────── */
.cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--border); }
@media (max-width: 780px) { .cards { grid-template-columns: 1fr; } }

.card {
  position: relative;
  display: flex; flex-direction: column;
  padding: 40px 36px;
  background: var(--bg);
  transition: background 0.22s var(--ease);
}
.section--sub .card { background: var(--bg-sub); }
.card:hover { background: var(--surface); }

.card-num {
  position: absolute; top: 40px; right: 36px;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  color: var(--fg-3);
  letter-spacing: 0.08em;
}
.card-ico { color: var(--accent); font-size: 1.25rem; margin-bottom: 26px; }
.card h3 { font-size: 1.0625rem; }
.card > p { margin-top: 14px; font-size: 0.9375rem; color: var(--fg-2); line-height: 1.65; flex: 1; }

.tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 26px; }
.tag {
  padding: 4px 10px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.625rem;
  color: var(--fg-3);
}

/* ── PANELS ─────────────────────────────────────────────────── */
.split { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 1px; background: var(--border); }
.panel { padding: 36px 32px; background: var(--bg); }
.section--sub .panel { background: var(--bg-sub); }

.panel-head { display: flex; align-items: center; gap: 12px; padding-bottom: 24px; margin-bottom: 28px; border-bottom: 1px solid var(--border); }
.panel-head i { color: var(--accent); font-size: 0.9375rem; flex: none; }
.panel-head h3 { font-size: 0.9375rem; letter-spacing: 0.01em; }

.skill-group + .skill-group { margin-top: 28px; }
.skill-group-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.625rem;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--fg-3);
  margin-bottom: 14px;
}
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 12px;
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  font-size: 0.8125rem; font-weight: 450;
  color: var(--fg);
  transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
}
.chip:hover { border-color: var(--accent-line); color: var(--accent); }
.chip i { font-size: 0.8125rem; color: var(--fg-3); }
.chip:hover i { color: var(--accent); }

/* education timeline */
.edu { position: relative; padding-left: 24px; }
.edu::before { content: ''; position: absolute; left: 3px; top: 6px; bottom: 6px; width: 1px; background: var(--border); }
.edu-item { position: relative; }
.edu-item + .edu-item { margin-top: 28px; }
.edu-item::before {
  content: ''; position: absolute; left: -24px; top: 7px;
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--bg); border: 1px solid var(--border-strong);
}
.section--sub .edu-item::before { background: var(--bg-sub); }
.edu-item:first-child::before { background: var(--accent); border-color: var(--accent); }
.edu-deg { font-size: 0.9375rem; font-weight: 600; line-height: 1.45; }
.edu-inst { margin-top: 5px; font-size: 0.8125rem; color: var(--fg-2); }
.edu-meta { margin-top: 7px; font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-3); }

/* ── PROCESS ────────────────────────────────────────────────── */
.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 1px; background: var(--border); }
.step { padding: 32px 26px; background: var(--bg); transition: background 0.2s var(--ease); }
.section--sub .step { background: var(--bg-sub); }
.step:hover { background: var(--surface); }
.step-n {
  font-family: var(--font-mono);
  font-size: 0.6875rem; font-weight: 500;
  letter-spacing: 0.1em;
  color: var(--accent);
  margin-bottom: 20px;
}
.step h3 { font-size: 0.9375rem; }
.step p { margin-top: 10px; font-size: 0.875rem; color: var(--fg-2); line-height: 1.6; }

/* ── BACKGROUND TRACKS (Experience | Education) ──────────────── */
.tracks {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  gap: 56px;
  align-items: start;
}
.track { min-width: 0; }
.track-head {
  display: flex; align-items: center; gap: 11px;
  padding-bottom: 18px;
  margin-bottom: 28px;
  border-bottom: 1px solid var(--border);
}
.track-head i { color: var(--accent); font-size: 0.875rem; flex: none; }
.track-head h3 {
  font-family: var(--font-mono);
  font-size: 0.6875rem; font-weight: 500;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--fg-2);
}

@media (max-width: 900px) {
  .tracks { grid-template-columns: 1fr; gap: 52px; }
}

/* ── EXPERIENCE ─────────────────────────────────────────────── */
.exp-card { border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); overflow: hidden; }
.exp-head { display: flex; align-items: flex-start; gap: 22px; padding: 36px; border-bottom: 1px solid var(--border); }
.exp-logo {
  display: grid; place-items: center;
  width: 54px; height: 54px; flex: none;
  border-radius: var(--r);
  border: 1px solid var(--accent-line);
  background: var(--accent-soft);
  color: var(--accent);
  font-family: var(--font-display);
  font-size: 1.625rem; font-weight: 400;
}
.exp-headings { flex: 1; min-width: 0; }
.exp-role { font-size: 1.125rem; }
.exp-org { margin-top: 7px; font-size: 0.9375rem; font-weight: 550; color: var(--accent); }
.exp-meta {
  display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px;
  margin-top: 14px;
  font-family: var(--font-mono);
  font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--fg-3);
}
.exp-meta span { display: inline-flex; align-items: center; gap: 7px; }

.exp-body { padding: 32px 36px; }
.exp-body p { font-size: 0.9375rem; color: var(--fg-2); line-height: 1.7; max-width: 76ch; text-wrap: pretty; }
.exp-body p + p { margin-top: 16px; }

.exp-projects-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; flex-wrap: wrap;
  padding: 0 36px 18px;
}
.exp-projects-label { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-3); }
.exp-legend { display: flex; gap: 16px; flex-wrap: wrap; }
.exp-legend span { display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.06em; color: var(--fg-3); }
.exp-legend i { width: 6px; height: 6px; border-radius: 50%; }
.exp-legend .dot-fe { background: var(--accent); }
.exp-legend .dot-ux { background: var(--accent-2); }

.exp-projects { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 1px; background: var(--border); border-top: 1px solid var(--border); }
.exp-proj { display: flex; flex-direction: column; gap: 16px; padding: 24px; background: var(--surface); transition: background 0.2s var(--ease); }
.exp-proj:hover { background: var(--surface-2); }
.exp-proj-name { font-size: 0.9375rem; font-weight: 600; line-height: 1.35; }
.exp-proj-note { margin-top: -8px; font-size: 0.8125rem; color: var(--fg-3); line-height: 1.55; }
.exp-discs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
.disc {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 9px;
  border-radius: var(--r-sm);
  font-family: var(--font-mono);
  font-size: 0.5625rem; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase;
}
.disc i { font-size: 0.5625rem; }
.disc--fe { color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line); }
.disc--ux { color: var(--accent-2); background: var(--accent-2-soft); border: 1px solid var(--accent-2-line); }

/* ── PROJECT FILTERS ────────────────────────────────────────── */
.filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 44px; }
.filter {
  padding: 8px 15px;
  border: 1px solid var(--border);
  border-radius: var(--r-full);
  font-family: var(--font-mono);
  font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--fg-3);
  transition: color 0.18s var(--ease), background 0.18s var(--ease), border-color 0.18s var(--ease);
}
.filter:hover { color: var(--fg); border-color: var(--border-strong); }
.filter.is-active { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }

/* ── PROJECT GRID ───────────────────────────────────────────── */
.proj-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
.proj { display: flex; flex-direction: column; background: var(--bg); transition: background 0.22s var(--ease); }
.section--sub .proj { background: var(--bg-sub); }
.proj:hover { background: var(--surface); }
.proj[hidden] { display: none; }

.proj-media { position: relative; aspect-ratio: 16 / 10; background: var(--surface-2); overflow: hidden; border-bottom: 1px solid var(--border); }
.proj-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
.proj:hover .proj-media img { transform: scale(1.04); }

.proj-tech {
  position: absolute; top: 14px; right: 14px;
  padding: 4px 10px;
  border-radius: var(--r-sm);
  background: color-mix(in srgb, var(--accent) 88%, transparent);
  color: var(--accent-fg);
  font-family: var(--font-mono);
  font-size: 0.5625rem; font-weight: 500;
  letter-spacing: 0.12em; text-transform: uppercase;
}

.proj-kind {
  position: absolute; top: 14px; left: 14px;
  padding: 4px 10px;
  border-radius: var(--r-sm);
  background: color-mix(in srgb, var(--bg) 90%, transparent);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.5625rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--fg-2);
}

.proj-body { display: flex; flex-direction: column; flex: 1; padding: 26px 24px; }
.proj-title { font-size: 1rem; line-height: 1.35; }
.proj-desc { margin-top: 12px; font-size: 0.875rem; color: var(--fg-2); line-height: 1.65; flex: 1; }
.proj-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; }
.proj-stack span {
  padding: 3px 8px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.5625rem; letter-spacing: 0.06em;
  color: var(--fg-3);
}
.proj-links { display: flex; gap: 20px; margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--border); }
.link {
  display: inline-flex; align-items: center; gap: 7px;
  font-family: var(--font-mono);
  font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--fg-3);
  transition: color 0.18s var(--ease);
}
.link:hover { color: var(--accent); }

.proj-empty { padding: 72px 24px; text-align: center; color: var(--fg-3); font-family: var(--font-mono); font-size: 0.8125rem; }

/* ── CERTIFICATIONS ─────────────────────────────────────────── */
.cert-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
.cert { display: flex; gap: 18px; padding: 28px 24px; background: var(--bg); transition: background 0.2s var(--ease); }
.section--sub .cert { background: var(--bg-sub); }
.cert:hover { background: var(--surface); }
.cert-ico { color: var(--accent); font-size: 1.125rem; flex: none; width: 24px; }
.cert-body { min-width: 0; flex: 1; }
.cert-name { font-size: 0.9375rem; font-weight: 600; line-height: 1.45; }
.cert-org { margin-top: 8px; font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-3); }
.cert-foot { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 16px; }
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 3px 9px;
  border-radius: var(--r-sm);
  font-family: var(--font-mono);
  font-size: 0.5625rem; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase;
}
.badge--issued { color: var(--pass); background: var(--accent-soft); border: 1px solid var(--accent-line); }
.badge--progress { color: var(--fg-3); border: 1px solid var(--border-strong); }
.cert-year { font-family: var(--font-mono); font-size: 0.625rem; color: var(--fg-3); letter-spacing: 0.06em; }

/* ── CONTACT ────────────────────────────────────────────────── */
.contact-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 72px; align-items: start; }
.contact-lede { font-size: 1.0625rem; color: var(--fg-2); text-wrap: pretty; }

.info-list { margin-top: 36px; }
.info-row { display: flex; align-items: center; gap: 18px; padding: 18px 0; border-top: 1px solid var(--border); }
.info-row:last-child { border-bottom: 1px solid var(--border); }
.info-ico { color: var(--accent); font-size: 0.875rem; flex: none; width: 20px; }
.info-k { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-3); }
.info-v { margin-top: 4px; font-size: 0.9375rem; font-weight: 500; }
.info-v a { transition: color 0.18s var(--ease); }
.info-v a:hover { color: var(--accent); }

.form { padding: 36px; border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface); }
.form h3 { font-size: 1rem; margin-bottom: 30px; }
.field { margin-bottom: 20px; }
.field-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
.field label {
  display: block; margin-bottom: 9px;
  font-family: var(--font-mono);
  font-size: 0.625rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--fg-3);
}
.input {
  width: 100%;
  padding: 13px 15px;
  border: 1px solid var(--border);
  border-radius: var(--r);
  background: var(--bg);
  font-size: 0.9375rem;
  transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
}
.input::placeholder { color: var(--fg-3); }
.input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
textarea.input { resize: vertical; min-height: 130px; }

.form-note { margin-top: 16px; font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.04em; color: var(--fg-3); text-align: center; }
.form-status { margin-top: 18px; padding: 13px 15px; border-radius: var(--r); font-size: 0.875rem; display: none; }
.form-status.is-ok { display: block; color: var(--accent); background: var(--accent-soft); border: 1px solid var(--accent-line); }
.form-status.is-err { display: block; color: var(--danger); background: var(--danger-soft); border: 1px solid var(--danger-line); }

.hp { position: absolute; left: -9999px; opacity: 0; pointer-events: none; }

/* ── FOOTER ─────────────────────────────────────────────────── */
.footer { border-top: 1px solid var(--border); background: var(--bg-sub); }
.foot-grid { display: grid; grid-template-columns: 1.7fr 1fr 1fr 1.2fr; gap: 56px; padding: 88px 0 64px; }
.foot-brand .brand { font-size: 1.625rem; }
.foot-desc { margin-top: 18px; max-width: 32ch; font-size: 0.875rem; color: var(--fg-2); line-height: 1.65; }
.foot-socials { display: flex; gap: 8px; margin-top: 26px; }

.foot-col h4 {
  font-family: var(--font-mono);
  font-size: 0.625rem; font-weight: 500;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--fg-3);
  margin-bottom: 22px;
}
.foot-col li + li { margin-top: 12px; }
.foot-col a { font-size: 0.875rem; color: var(--fg-2); transition: color 0.18s var(--ease); }
.foot-col a:hover { color: var(--accent); }

.foot-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding: 26px 0; border-top: 1px solid var(--border); }
.foot-copy { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--fg-3); }
.foot-avail { display: inline-flex; align-items: center; gap: 9px; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.04em; color: var(--fg-2); }

/* ── BACK TO TOP ────────────────────────────────────────────── */
#toTop {
  position: fixed; right: 28px; bottom: 28px; z-index: 900;
  display: grid; place-items: center;
  width: 42px; height: 42px;
  border-radius: var(--r);
  border: 1px solid var(--border-strong);
  background: var(--surface);
  color: var(--fg-2);
  box-shadow: var(--shadow);
  opacity: 0; visibility: hidden; transform: translateY(10px);
  transition: opacity 0.24s var(--ease), transform 0.24s var(--ease), visibility 0.24s var(--ease), color 0.18s var(--ease);
}
#toTop.is-visible { opacity: 1; visibility: visible; transform: none; }
#toTop:hover { color: var(--accent); border-color: var(--accent-line); }

/* ── SCROLL REVEAL ──────────────────────────────────────────── */
.js .reveal { opacity: 0; transform: translateY(16px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
.reveal.is-in { opacity: 1; transform: none; }
.js .reveal-group > * { opacity: 0; transform: translateY(16px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); }
.reveal-group.is-in > * { opacity: 1; transform: none; }
.reveal-group.is-in > *:nth-child(2) { transition-delay: 0.06s; }
.reveal-group.is-in > *:nth-child(3) { transition-delay: 0.12s; }
.reveal-group.is-in > *:nth-child(4) { transition-delay: 0.18s; }
.reveal-group.is-in > *:nth-child(5) { transition-delay: 0.24s; }
.reveal-group.is-in > *:nth-child(6) { transition-delay: 0.30s; }

@media (prefers-reduced-motion: reduce) {
  .js .reveal, .js .reveal-group > * { opacity: 1; transform: none; }
}

/* ── HERO BAND + ARCH PORTRAIT ──────────────────────────────────
   The arch is the signature shape: a true semicircular top (999px
   clamps to half the width) cropping the portrait like a gallery
   niche. A hairline runs behind its base to seat it on the page.
   ─────────────────────────────────────────────────────────────── */
.band { border-bottom: 1px solid var(--border); }

.portrait {
  position: relative; z-index: 1;
  width: 100%; max-width: 392px;
  aspect-ratio: 4 / 5;
  border-radius: var(--r-full) var(--r-full) var(--r-lg) var(--r-lg);
  background: var(--arch-fill);
  overflow: hidden;
  /* contain the blend below so it mixes with the arch fill, not the page */
  isolation: isolate;
}
/* The studio shot has a pure white ground. Multiplying it onto the arch fill
   maps that white onto the niche colour and leaves the subject intact — so the
   portrait reads as cut into the page rather than pasted on top of it. */
.portrait img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: 50% 74%;
  mix-blend-mode: multiply;
}

.portrait-rule {
  position: absolute; left: 0; right: 0; bottom: 16%;
  height: 1px; background: var(--border-strong);
  z-index: 0;
}
/* the rule only bleeds past the portrait where the column has room for it */
@media (min-width: 768px) {
  .portrait-rule { left: -8%; right: -8%; }
}

/* ── HERO META RAIL ─────────────────────────────────────────── */
.hero-rail {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 72px;
  border-top: 1px solid var(--border-strong);
}
.rail-cell { padding: 24px 28px; border-left: 1px solid var(--border); }
.rail-cell:first-child { border-left: 0; padding-left: 0; }
.rail-k {
  font-family: var(--font-mono);
  font-size: 0.625rem; font-weight: 500;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--fg-3);
}
.rail-v {
  margin-top: 9px;
  font-size: 0.875rem; font-weight: 550;
  line-height: 1.45;
  color: var(--fg);
}
.rail-status { display: inline-flex; align-items: center; gap: 9px; }

/* ── STATS ──────────────────────────────────────────────────── */
.stats { background: var(--bg-sub); border-bottom: 1px solid var(--border); }
.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.stat {
  padding: 48px 28px;
  text-align: center;
  border-left: 1px solid var(--border);
}
.stat:first-child { border-left: 0; }
.stat-n {
  font-family: var(--font-display);
  font-size: clamp(1.875rem, 3.4vw, 2.5rem);
  font-weight: 800;
  letter-spacing: -0.045em;
  line-height: 1;
}
.stat-n em { font-style: normal; color: var(--accent); }
.stat-l {
  margin-top: 12px;
  font-family: var(--font-mono);
  font-size: 0.625rem; font-weight: 500;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--fg-3);
}

/* ── HERO RAIL + STATS · RESPONSIVE ─────────────────────────── */
@media (max-width: 900px) {
  .hero-rail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .rail-cell:nth-child(odd) { border-left: 0; padding-left: 0; }
  .rail-cell:nth-child(n + 3) { border-top: 1px solid var(--border); }

  .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .stat { padding: 36px 20px; }
  .stat:nth-child(odd) { border-left: 0; }
  .stat:nth-child(n + 3) { border-top: 1px solid var(--border); }
}

@media (max-width: 560px) {
  .hero-rail { grid-template-columns: 1fr; margin-top: 48px; }
  .rail-cell { border-left: 0; padding: 20px 0; }
  .rail-cell:not(:first-child) { border-top: 1px solid var(--border); }

  .stats-grid { grid-template-columns: 1fr; }
  .stat { border-left: 0; padding: 28px 16px; }
  .stat:not(:first-child) { border-top: 1px solid var(--border); }
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVE
   ═══════════════════════════════════════════════════════════════ */

@media (max-width: 1080px) {
  .section { padding: 100px 0; }
  .sec-head { margin-bottom: 60px; }
  .hero-grid { gap: 32px; }
  .about-grid, .contact-grid { gap: 52px; }
  .foot-grid { grid-template-columns: 1fr 1fr; gap: 44px; }
  .foot-brand { grid-column: 1 / -1; }
}

@media (max-width: 900px) {
  .nav-menu {
    position: fixed;
    inset: var(--nav-h) 0 auto;
    flex-direction: column; align-items: stretch; gap: 0;
    padding: 12px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    transform: translateY(-12px); opacity: 0; visibility: hidden;
    transition: transform 0.24s var(--ease), opacity 0.24s var(--ease), visibility 0.24s var(--ease);
  }
  .nav-menu.is-open { transform: none; opacity: 1; visibility: visible; }
  .nav-menu a { padding: 14px 16px; font-size: 0.8125rem; }
  .nav-menu a.is-active::after { left: 6px; top: 50%; bottom: auto; transform: translateY(-50%); }

  .burger { display: grid; }
  .nav-cta { display: none; }

  .hero { padding: calc(var(--nav-h) + 40px) 0 56px; }
  /* rail drops below the statement + portrait pair */
  .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); gap: 40px; }


  .about-grid, .contact-grid { grid-template-columns: 1fr; }
}

@media (max-width: 640px) {
  .wrap { padding: 0 20px; }
  .section { padding: 80px 0; }
  .sec-head { margin-bottom: 44px; }

  .hero-grid { grid-template-columns: 1fr; gap: 40px; }
  .hero h1 { font-size: clamp(2.125rem, 11vw, 2.75rem); }
  .hero-actions { gap: 14px; }
  .hero-actions .btn-primary { flex: 1 1 100%; }
  .socials { flex-wrap: wrap; }

  .pillars { grid-template-columns: 1fr; }
  .panel { padding: 28px 24px; }
  .card { padding: 32px 24px; }
  .card-num { top: 32px; right: 24px; }
  .form { padding: 26px; }
  .field-row { grid-template-columns: 1fr; gap: 0; }
  .field-row .field { margin-bottom: 20px; }

  .proj-grid, .cert-grid, .cards { grid-template-columns: 1fr; }
  .cert { flex-direction: column; gap: 14px; }

  .exp-head { flex-direction: column; gap: 18px; padding: 26px; }
  .exp-body { padding: 26px; }
  .exp-projects-head { padding: 0 26px 18px; }
  .exp-projects { grid-template-columns: 1fr; }
  .exp-proj { padding: 22px 26px; }

  .foot-grid { grid-template-columns: 1fr; gap: 40px; padding: 64px 0 44px; }
  .foot-bottom { flex-direction: column; align-items: flex-start; gap: 14px; }

  #toTop { right: 18px; bottom: 18px; }
}

@media (max-width: 420px) {
  /* one per row — two columns would wrap the mono labels — so tighten
     the vertical rhythm to keep the block from running long */
  .socials-label { display: none; }
}

/* ── PRINT ─────────────────────────────────────────────────── */
@media print {
  .nav, #toTop, .hero::before, .form, .filters { display: none !important; }
  body { background: #fff; color: #000; }
  .section { padding: 24px 0; break-inside: avoid; }
  .js .reveal, .js .reveal-group > * { opacity: 1 !important; transform: none !important; }
  a::after { content: ' (' attr(href) ')'; font-size: 0.75em; color: #555; }
}
