/* ═══════════════════════════════════════════════════════════════
   Niragi Kodagoda — Portfolio
   Design system: neutral surfaces, hairline borders, one accent,
   strict 4px spacing scale, restrained motion.
   ═══════════════════════════════════════════════════════════════ */

/* ── TOKENS · LIGHT ─────────────────────────────────────────── */
:root {
  --bg:            #ffffff;
  --bg-sub:        #fafafa;
  --surface:       #ffffff;
  --surface-2:     #f4f4f5;
  --border:        #e4e4e7;
  --border-strong: #d4d4d8;

  --fg:            #09090b;
  --fg-2:          #52525b;
  --fg-3:          #71717a;

  --accent:        #2563eb;
  --accent-hover:  #1d4ed8;
  --accent-fg:     #ffffff;
  --accent-soft:   rgba(37, 99, 235, 0.08);
  --accent-line:   rgba(37, 99, 235, 0.22);
  --pass:          #059669;
  --accent-2:      #7c3aed;
  --accent-2-soft: rgba(124, 58, 237, 0.08);
  --accent-2-line: rgba(124, 58, 237, 0.24);

  --shadow-sm: 0 1px 2px rgba(9, 9, 11, 0.05);
  --shadow:    0 4px 16px -4px rgba(9, 9, 11, 0.08);
  --shadow-lg: 0 16px 48px -12px rgba(9, 9, 11, 0.14);

  --font-display: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
  --font-sans:    'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
  --font-mono:    'JetBrains Mono', ui-monospace, 'SFMono-Regular', monospace;

  --r-sm:   8px;
  --r:      12px;
  --r-lg:   20px;
  --r-full: 999px;

  --ease: cubic-bezier(0.4, 0, 0.2, 1);
  --nav-h: 68px;
}

/* ── TOKENS · DARK ──────────────────────────────────────────── */
html[data-theme='dark'] {
  --bg:            #09090b;
  --bg-sub:        #0c0c0f;
  --surface:       #131316;
  --surface-2:     #18181b;
  --border:        #27272a;
  --border-strong: #3f3f46;

  --fg:            #fafafa;
  --fg-2:          #a1a1aa;
  --fg-3:          #8b8b94;

  --accent:        #60a5fa;
  --accent-hover:  #93c5fd;
  --accent-fg:     #09090b;
  --accent-soft:   rgba(96, 165, 250, 0.12);
  --accent-line:   rgba(96, 165, 250, 0.3);
  --pass:          #34d399;
  --accent-2:      #a78bfa;
  --accent-2-soft: rgba(167, 139, 250, 0.14);
  --accent-2-line: rgba(167, 139, 250, 0.32);

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow:    0 4px 16px -4px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 16px 48px -12px rgba(0, 0, 0, 0.6);
}

/* ── RESET ──────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--nav-h) + 24px);
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.6;
  color: var(--fg);
  background: var(--bg);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-feature-settings: 'cv11', 'ss01';
}

img, svg { display: block; max-width: 100%; height: auto; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; background: none; border: none; cursor: pointer; }
input, textarea, select { font: inherit; color: inherit; }
ul, ol { list-style: none; }

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 4px;
}

::selection { background: var(--accent); color: var(--accent-fg); }

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: var(--r-full); border: 3px solid var(--bg); }
::-webkit-scrollbar-thumb:hover { background: var(--fg-3); }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ── ACCESSIBILITY HELPERS ──────────────────────────────────── */
.sr-only {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
}

.skip {
  position: absolute; top: 8px; left: 8px; z-index: 2000;
  padding: 10px 18px; border-radius: var(--r-sm);
  background: var(--accent); color: var(--accent-fg);
  font-size: 0.875rem; font-weight: 600;
  transform: translateY(-200%);
  transition: transform 0.2s var(--ease);
}
.skip:focus { transform: translateY(0); }

/* ── TYPOGRAPHY PRIMITIVES ──────────────────────────────────── */
h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.02em;
  text-wrap: balance;
}

.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-mono);
  font-size: 0.75rem; font-weight: 500;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--accent);
}
.eyebrow::before {
  content: ''; width: 20px; height: 1px;
  background: var(--accent); opacity: 0.5;
}

/* ── LAYOUT ─────────────────────────────────────────────────── */
.wrap { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }

.section { padding: 112px 0; position: relative; }
.section--sub { background: var(--bg-sub); }
.section--bordered { border-block: 1px solid var(--border); }

.sec-head { max-width: 660px; margin-bottom: 64px; }
.sec-head--center { margin-inline: auto; text-align: center; }
.sec-head--center .eyebrow::before { display: none; }

.sec-title {
  font-size: clamp(2rem, 4vw, 2.75rem);
  margin: 16px 0 0;
}
.sec-sub {
  margin-top: 16px;
  font-size: 1.0625rem;
  color: var(--fg-2);
  max-width: 58ch;
  text-wrap: pretty;
}
.sec-head--center .sec-sub { margin-inline: auto; }

/* ── BUTTONS ────────────────────────────────────────────────── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 9px;
  padding: 12px 22px;
  border-radius: var(--r-sm);
  font-size: 0.9375rem; font-weight: 550;
  letter-spacing: -0.01em;
  white-space: nowrap;
  border: 1px solid transparent;
  transition: background 0.18s var(--ease), border-color 0.18s var(--ease),
              color 0.18s var(--ease), transform 0.18s var(--ease);
}
.btn i { font-size: 0.875em; }
.btn:active { transform: translateY(1px); }

.btn-primary { background: var(--accent); color: var(--accent-fg); }
.btn-primary:hover { background: var(--accent-hover); }

.btn-ghost {
  background: var(--surface);
  color: var(--fg);
  border-color: var(--border);
}
.btn-ghost:hover { border-color: var(--fg-3); background: var(--surface-2); }

.btn-block { width: 100%; }

/* ── NAV ────────────────────────────────────────────────────── */
.nav {
  position: fixed; inset: 0 0 auto; z-index: 1000;
  height: var(--nav-h);
  border-bottom: 1px solid transparent;
  transition: background 0.25s var(--ease), border-color 0.25s var(--ease),
              backdrop-filter 0.25s var(--ease);
}
.nav.is-scrolled {
  background: color-mix(in srgb, var(--bg) 82%, transparent);
  backdrop-filter: saturate(180%) blur(16px);
  -webkit-backdrop-filter: saturate(180%) blur(16px);
  border-bottom-color: var(--border);
}

.nav-in {
  height: 100%;
  display: flex; align-items: center; justify-content: space-between; gap: 24px;
}

.brand {
  font-family: var(--font-display);
  font-size: 1.1875rem; font-weight: 700;
  letter-spacing: -0.03em;
  display: inline-flex; align-items: baseline; gap: 1px;
}
.brand em { color: var(--accent); font-style: normal; }

.nav-menu { display: flex; align-items: center; gap: 4px; }
.nav-menu a {
  position: relative;
  display: block;
  padding: 8px 13px;
  border-radius: var(--r-sm);
  font-size: 0.875rem; font-weight: 500;
  color: var(--fg-2);
  transition: color 0.18s var(--ease), background 0.18s var(--ease);
}
.nav-menu a:hover { color: var(--fg); background: var(--surface-2); }
.nav-menu a.is-active { color: var(--fg); font-weight: 600; }
.nav-menu a.is-active::after {
  content: ''; position: absolute; left: 13px; right: 13px; bottom: 2px;
  height: 2px; border-radius: 2px; background: var(--accent);
}

.nav-right { display: flex; align-items: center; gap: 8px; }

.icon-btn {
  display: grid; place-items: center;
  width: 38px; height: 38px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--fg-2);
  font-size: 0.875rem;
  transition: color 0.18s var(--ease), border-color 0.18s var(--ease), background 0.18s var(--ease);
}
.icon-btn:hover { color: var(--fg); border-color: var(--fg-3); }

.nav-cta { padding: 9px 18px; font-size: 0.875rem; }

.burger { display: none; }

/* ── HERO ───────────────────────────────────────────────────── */
.hero {
  position: relative;
  padding: calc(var(--nav-h) + 88px) 0 96px;
  overflow: hidden;
}

/* single soft radial wash — no floating orbs */
.hero::before {
  content: ''; position: absolute; inset: 0; z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(60rem 32rem at 78% -8%, var(--accent-soft), transparent 70%),
    linear-gradient(180deg, var(--bg-sub), var(--bg) 60%);
}

.hero-copy { min-width: 0; }

.hero-in {
  position: relative; z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  gap: 72px;
  align-items: center;
}

.status {
  display: inline-flex; align-items: center; gap: 9px;
  padding: 6px 14px 6px 12px;
  border: 1px solid var(--border);
  border-radius: var(--r-full);
  background: var(--surface);
  font-family: var(--font-mono);
  font-size: 0.75rem; font-weight: 500;
  letter-spacing: 0.02em;
  color: var(--fg-2);
  box-shadow: var(--shadow-sm);
}
.status-dot {
  position: relative;
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--pass);
  flex: none;
}
.status-dot::after {
  content: ''; position: absolute; inset: -3px;
  border-radius: 50%; border: 1px solid var(--pass);
  opacity: 0; animation: ping 2.4s var(--ease) infinite;
}
@keyframes ping {
  0%   { opacity: 0.7; transform: scale(0.6); }
  70%  { opacity: 0;   transform: scale(1.5); }
  100% { opacity: 0;   transform: scale(1.5); }
}

.hero h1 {
  margin: 22px 0 0;
  font-size: clamp(2.75rem, 6.2vw, 4.25rem);
  letter-spacing: -0.035em;
  line-height: 1.02;
}
.hero h1 .line-2 {
  display: block;
  margin-top: 6px;
  font-size: 0.6em;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--fg-2);
}

.hero-role {
  display: flex; align-items: center; gap: 9px;
  margin-top: 20px;
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  font-weight: 400;
  letter-spacing: 0.02em;
  color: var(--fg-3);
}
.hero-role i { font-size: 0.8125rem; }

.hero-lede {
  margin-top: 22px;
  max-width: 52ch;
  font-size: 1.0625rem;
  color: var(--fg-2);
  text-wrap: pretty;
}

.hero-actions {
  display: flex; flex-wrap: wrap; gap: 12px;
  margin-top: 36px;
}

.socials {
  display: flex; align-items: center; gap: 10px;
  margin-top: 40px;
  padding-top: 28px;
  border-top: 1px solid var(--border);
}
.socials-label {
  font-family: var(--font-mono);
  font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--fg-3);
  margin-right: 6px;
}
.soc {
  display: grid; place-items: center;
  width: 38px; height: 38px;
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--fg-2);
  font-size: 0.9375rem;
  transition: color 0.18s var(--ease), border-color 0.18s var(--ease), transform 0.18s var(--ease);
}
.soc:hover { color: var(--accent); border-color: var(--accent-line); transform: translateY(-2px); }

/* ── HERO PORTRAIT ──────────────────────────────────────────── */
.hero-media { position: relative; }

.portrait {
  position: relative;
  border-radius: var(--r-lg);
  border: 1px solid var(--border);
  background: var(--surface-2);
  overflow: hidden;
  aspect-ratio: 4 / 5;
  box-shadow: var(--shadow-lg);
}
/* Headshot is 3:4 in a 4:5 frame, so cover trims ~6% vertically. Anchoring low
   spends that trim on the empty headroom rather than the subject. */
.portrait img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: 50% 80%;
}

.portrait-card {
  position: absolute; left: 20px; right: 20px; bottom: 20px;
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px;
  border-radius: var(--r);
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--surface) 88%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: var(--shadow);
}
.portrait-card i { color: var(--accent); font-size: 1rem; }
.portrait-card-k {
  font-family: var(--font-mono);
  font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--fg-3);
}
.portrait-card-v { font-size: 0.875rem; font-weight: 600; }

/* ── STATS STRIP ────────────────────────────────────────────── */
.stats {
  border-block: 1px solid var(--border);
  background: var(--bg-sub);
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
.stat {
  padding: 40px 28px;
  text-align: center;
  border-left: 1px solid var(--border);
}
.stat:first-child { border-left: 0; }
.stat-n {
  font-family: var(--font-display);
  font-size: clamp(1.875rem, 3.4vw, 2.5rem);
  font-weight: 600;
  letter-spacing: -0.035em;
  line-height: 1;
}
.stat-n em { font-style: normal; color: var(--accent); }
.stat-l {
  margin-top: 10px;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--fg-3);
}

/* ── ABOUT ──────────────────────────────────────────────────── */
.about-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 64px;
  align-items: start;
}

.prose p {
  color: var(--fg-2);
  font-size: 1.0625rem;
  text-wrap: pretty;
}
.prose p + p { margin-top: 18px; }
.prose strong { color: var(--fg); font-weight: 600; }

.pillars {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}
.pillar {
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: var(--r);
  background: var(--surface);
  transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
}
.pillar:hover { border-color: var(--border-strong); transform: translateY(-3px); }
.pillar-ico {
  display: grid; place-items: center;
  width: 38px; height: 38px;
  border-radius: var(--r-sm);
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 0.9375rem;
  margin-bottom: 16px;
}
.pillar h3 { font-size: 1rem; }
.pillar p {
  margin-top: 8px;
  font-size: 0.875rem;
  color: var(--fg-2);
  line-height: 1.55;
}

.facts {
  display: flex; flex-wrap: wrap; gap: 10px;
  margin-top: 32px;
  padding-top: 28px;
  border-top: 1px solid var(--border);
}
.fact {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 7px 14px;
  border: 1px solid var(--border);
  border-radius: var(--r-full);
  background: var(--surface);
  font-size: 0.8125rem;
  color: var(--fg-2);
}
.fact i { font-size: 0.75rem; color: var(--fg-3); }
.fact--live i { color: var(--pass); }

.about-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

/* ── CARD GRID (expertise) ──────────────────────────────────── */
.cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}
@media (max-width: 780px) {
  .cards { grid-template-columns: 1fr; }
}
.card {
  position: relative;
  display: flex; flex-direction: column;
  padding: 32px 28px;
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  background: var(--surface);
  overflow: hidden;
  transition: border-color 0.22s var(--ease), transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
}
.card::before {
  content: ''; position: absolute; inset: 0 0 auto; height: 2px;
  background: var(--accent);
  transform: scaleX(0); transform-origin: left;
  transition: transform 0.32s var(--ease);
}
.card:hover { border-color: var(--border-strong); transform: translateY(-4px); box-shadow: var(--shadow); }
.card:hover::before { transform: scaleX(1); }

.card-num {
  position: absolute; top: 26px; right: 28px;
  font-family: var(--font-mono);
  font-size: 0.75rem; font-weight: 500;
  color: var(--fg-3);
  opacity: 0.55;
}
.card-ico {
  display: grid; place-items: center;
  width: 44px; height: 44px;
  border-radius: var(--r);
  border: 1px solid var(--accent-line);
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 1.0625rem;
  margin-bottom: 22px;
}
.card h3 { font-size: 1.125rem; }
.card > p {
  margin-top: 12px;
  font-size: 0.9375rem;
  color: var(--fg-2);
  line-height: 1.6;
  flex: 1;
}

.tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 22px; }
.tag {
  padding: 5px 11px;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  border: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  color: var(--fg-2);
  letter-spacing: 0.01em;
}

/* ── PANELS (skills + education) ────────────────────────────── */
.split {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
  gap: 20px;
}
.panel {
  padding: 32px;
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  background: var(--surface);
}
.panel-head {
  display: flex; align-items: center; gap: 14px;
  padding-bottom: 22px;
  margin-bottom: 26px;
  border-bottom: 1px solid var(--border);
}
.panel-head i {
  display: grid; place-items: center;
  width: 38px; height: 38px; flex: none;
  border-radius: var(--r-sm);
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 0.9375rem;
}
.panel-head h3 { font-size: 1.0625rem; }

/* capability groups — replaces arbitrary percentage bars */
.skill-group + .skill-group { margin-top: 26px; }
.skill-group-label {
  display: block;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.09em; text-transform: uppercase;
  color: var(--fg-3);
  margin-bottom: 12px;
}
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.chip {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 13px;
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  background: var(--surface-2);
  font-size: 0.8125rem; font-weight: 500;
  color: var(--fg);
  transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
}
.chip:hover { border-color: var(--accent-line); color: var(--accent); }
.chip i { font-size: 0.8125rem; color: var(--fg-3); }
.chip:hover i { color: var(--accent); }

/* education timeline */
.edu { position: relative; padding-left: 26px; }
.edu::before {
  content: ''; position: absolute; left: 4px; top: 6px; bottom: 6px;
  width: 1px; background: var(--border);
}
.edu-item { position: relative; }
.edu-item + .edu-item { margin-top: 26px; }
.edu-item::before {
  content: ''; position: absolute; left: -26px; top: 7px;
  width: 9px; height: 9px; border-radius: 50%;
  background: var(--bg);
  border: 2px solid var(--border-strong);
}
.edu-item:first-child::before { border-color: var(--accent); background: var(--accent); }
.edu-deg { font-size: 0.9375rem; font-weight: 600; line-height: 1.4; }
.edu-inst { margin-top: 5px; font-size: 0.8125rem; color: var(--fg-2); }
.edu-meta {
  margin-top: 6px;
  font-family: var(--font-mono);
  font-size: 0.6875rem; letter-spacing: 0.05em;
  color: var(--fg-3);
}

/* ── PROCESS STEPS ──────────────────────────────────────────── */
.steps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
  gap: 20px;
  counter-reset: step;
}
.step {
  position: relative;
  padding: 28px 24px;
  border: 1px solid var(--border);
  border-radius: var(--r);
  background: var(--surface);
  transition: border-color 0.2s var(--ease);
}
.step:hover { border-color: var(--border-strong); }
.step-n {
  display: grid; place-items: center;
  width: 34px; height: 34px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  background: var(--surface-2);
  font-family: var(--font-mono);
  font-size: 0.8125rem; font-weight: 600;
  color: var(--accent);
  margin-bottom: 18px;
}
.step h3 { font-size: 1rem; }
.step p { margin-top: 8px; font-size: 0.875rem; color: var(--fg-2); line-height: 1.55; }

/* ── PROJECT FILTERS ────────────────────────────────────────── */
.filters {
  display: flex; flex-wrap: wrap; gap: 8px;
  margin-bottom: 36px;
}
.filter {
  padding: 8px 15px;
  border: 1px solid var(--border);
  border-radius: var(--r-full);
  background: var(--surface);
  font-size: 0.8125rem; font-weight: 500;
  color: var(--fg-2);
  transition: color 0.18s var(--ease), background 0.18s var(--ease), border-color 0.18s var(--ease);
}
.filter:hover { color: var(--fg); border-color: var(--fg-3); }
.filter.is-active {
  background: var(--fg); color: var(--bg);
  border-color: var(--fg);
}
/* ── PROJECT GRID ───────────────────────────────────────────── */
.proj-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
  gap: 24px;
}
.proj {
  display: flex; flex-direction: column;
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  background: var(--surface);
  overflow: hidden;
  transition: border-color 0.22s var(--ease), transform 0.22s var(--ease), box-shadow 0.22s var(--ease);
}
.proj:hover { border-color: var(--border-strong); transform: translateY(-4px); box-shadow: var(--shadow-lg); }

/* filtered-out state — removed from flow, not just faded */
.proj[hidden] { display: none; }

.proj-media {
  position: relative;
  aspect-ratio: 16 / 10;
  background: var(--surface-2);
  border-bottom: 1px solid var(--border);
  overflow: hidden;
}
.proj-media img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.5s var(--ease);
}
.proj:hover .proj-media img { transform: scale(1.04); }

.proj-kind {
  position: absolute; top: 12px; left: 12px;
  padding: 5px 11px;
  border-radius: var(--r-full);
  background: color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.625rem;
  letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--fg-2);
}

.proj-body {
  display: flex; flex-direction: column; flex: 1;
  padding: 24px;
}
.proj-title { font-size: 1.0625rem; line-height: 1.3; }
.proj-desc {
  margin-top: 10px;
  font-size: 0.875rem;
  color: var(--fg-2);
  line-height: 1.6;
  flex: 1;
}
.proj-stack {
  display: flex; flex-wrap: wrap; gap: 6px;
  margin-top: 18px;
}
.proj-stack span {
  padding: 4px 9px;
  border-radius: 5px;
  background: var(--surface-2);
  border: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.625rem;
  color: var(--fg-2);
}
.proj-links {
  display: flex; gap: 18px;
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid var(--border);
}
.link {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 0.8125rem; font-weight: 550;
  color: var(--fg-2);
  transition: color 0.18s var(--ease);
}
.link:hover { color: var(--accent); }
.link i { font-size: 0.8125rem; }

.proj-empty {
  padding: 64px 24px;
  text-align: center;
  color: var(--fg-3);
  font-size: 0.9375rem;
}

/* ── CERTIFICATIONS ─────────────────────────────────────────── */
.cert-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
  gap: 16px;
}
.cert {
  display: flex; gap: 18px;
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: var(--r);
  background: var(--surface);
  transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
}
.cert:hover { border-color: var(--border-strong); transform: translateY(-3px); }
.cert-ico {
  display: grid; place-items: center;
  width: 44px; height: 44px; flex: none;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--accent);
  font-size: 1.125rem;
}
.cert-body { min-width: 0; flex: 1; }
.cert-name { font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; line-height: 1.4; }
.cert-org {
  margin-top: 6px;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.07em; text-transform: uppercase;
  color: var(--fg-3);
}
.cert-foot {
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  margin-top: 14px;
}
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 3px 10px;
  border-radius: var(--r-full);
  font-family: var(--font-mono);
  font-size: 0.625rem; font-weight: 500;
  letter-spacing: 0.05em; text-transform: uppercase;
}
.badge--issued {
  color: var(--pass);
  background: color-mix(in srgb, var(--pass) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--pass) 30%, transparent);
}
.badge--progress {
  color: var(--fg-2);
  background: var(--surface-2);
  border: 1px solid var(--border-strong);
}
.cert-year { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--fg-3); }

/* ── CONTACT ────────────────────────────────────────────────── */
.contact-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  gap: 56px;
  align-items: start;
}

.contact-lede {
  font-size: 1.0625rem;
  color: var(--fg-2);
  text-wrap: pretty;
}

.info-list { margin-top: 32px; }
.info-row {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 0;
  border-top: 1px solid var(--border);
}
.info-row:last-child { border-bottom: 1px solid var(--border); }
.info-ico {
  display: grid; place-items: center;
  width: 40px; height: 40px; flex: none;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--accent);
  font-size: 0.9375rem;
}
.info-k {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--fg-3);
}
.info-v { margin-top: 3px; font-size: 0.9375rem; font-weight: 500; }
.info-v a { transition: color 0.18s var(--ease); }
.info-v a:hover { color: var(--accent); }

/* form */
.form {
  padding: 32px;
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  background: var(--surface);
  box-shadow: var(--shadow);
}
.form h3 { font-size: 1.125rem; margin-bottom: 26px; }

.field { margin-bottom: 18px; }
.field-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}
.field label {
  display: block;
  margin-bottom: 8px;
  font-size: 0.8125rem; font-weight: 550;
  color: var(--fg-2);
}
.input {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: var(--r-sm);
  background: var(--bg);
  font-size: 0.9375rem;
  transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
}
.input::placeholder { color: var(--fg-3); }
.input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}
textarea.input { resize: vertical; min-height: 120px; }

.form-note {
  margin-top: 14px;
  font-size: 0.75rem;
  color: var(--fg-3);
  text-align: center;
}
.form-status {
  margin-top: 16px;
  padding: 12px 14px;
  border-radius: var(--r-sm);
  font-size: 0.875rem;
  display: none;
}
.form-status.is-ok {
  display: block;
  color: var(--pass);
  background: color-mix(in srgb, var(--pass) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--pass) 28%, transparent);
}
.form-status.is-err {
  display: block;
  color: #dc2626;
  background: rgba(220, 38, 38, 0.08);
  border: 1px solid rgba(220, 38, 38, 0.28);
}
html[data-theme='dark'] .form-status.is-err { color: #f87171; }

/* honeypot — hidden from humans, visible to naive bots */
.hp { position: absolute; left: -9999px; opacity: 0; pointer-events: none; }

/* ── FOOTER ─────────────────────────────────────────────────── */
.footer {
  border-top: 1px solid var(--border);
  background: var(--bg-sub);
}
.foot-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
  gap: 48px;
  padding: 72px 0 56px;
}
.foot-brand .brand { font-size: 1.25rem; }
.foot-desc {
  margin-top: 16px;
  max-width: 34ch;
  font-size: 0.875rem;
  color: var(--fg-2);
  line-height: 1.6;
}
.foot-socials { display: flex; gap: 9px; margin-top: 22px; }

.foot-col h4 {
  font-family: var(--font-mono);
  font-size: 0.6875rem; font-weight: 500;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--fg-3);
  margin-bottom: 18px;
}
.foot-col li + li { margin-top: 11px; }
.foot-col a {
  font-size: 0.875rem;
  color: var(--fg-2);
  transition: color 0.18s var(--ease);
}
.foot-col a:hover { color: var(--accent); }

.foot-bottom {
  display: flex; align-items: center; justify-content: space-between;
  gap: 20px; flex-wrap: wrap;
  padding: 24px 0;
  border-top: 1px solid var(--border);
}
.foot-copy { font-size: 0.8125rem; color: var(--fg-3); }
.foot-avail {
  display: inline-flex; align-items: center; gap: 9px;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--fg-2);
}

/* ── BACK TO TOP ────────────────────────────────────────────── */
#toTop {
  position: fixed; right: 24px; bottom: 24px; z-index: 900;
  display: grid; place-items: center;
  width: 44px; height: 44px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--fg-2);
  box-shadow: var(--shadow);
  opacity: 0; visibility: hidden;
  transform: translateY(10px);
  transition: opacity 0.24s var(--ease), transform 0.24s var(--ease),
              visibility 0.24s var(--ease), color 0.18s var(--ease);
}
#toTop.is-visible { opacity: 1; visibility: visible; transform: none; }
#toTop:hover { color: var(--accent); border-color: var(--accent-line); }

/* ── SCROLL REVEAL ──────────────────────────────────────────── */
.js .reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
}
.reveal.is-in { opacity: 1; transform: none; }

.js .reveal-group > * {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);
}
.reveal-group.is-in > * { opacity: 1; transform: none; }
.reveal-group.is-in > *:nth-child(2) { transition-delay: 0.07s; }
.reveal-group.is-in > *:nth-child(3) { transition-delay: 0.14s; }
.reveal-group.is-in > *:nth-child(4) { transition-delay: 0.21s; }
.reveal-group.is-in > *:nth-child(5) { transition-delay: 0.28s; }
.reveal-group.is-in > *:nth-child(6) { transition-delay: 0.35s; }

@media (prefers-reduced-motion: reduce) {
  .reveal, .reveal-group > * { opacity: 1; transform: none; }
}

/* ── EXPERIENCE ─────────────────────────────────────────────── */
.exp-card {
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  background: var(--surface);
  overflow: hidden;
}

.exp-head {
  display: flex; align-items: flex-start; gap: 20px;
  padding: 32px;
  border-bottom: 1px solid var(--border);
}

.exp-logo {
  display: grid; place-items: center;
  width: 56px; height: 56px; flex: none;
  border-radius: var(--r);
  border: 1px solid var(--accent-line);
  background: var(--accent-soft);
  color: var(--accent);
  font-family: var(--font-display);
  font-size: 1.5rem; font-weight: 700;
  letter-spacing: -0.04em;
}

.exp-headings { flex: 1; min-width: 0; }
.exp-role { font-size: 1.1875rem; }
.exp-org {
  margin-top: 6px;
  font-size: 0.9375rem; font-weight: 550;
  color: var(--accent);
}
.exp-meta {
  display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px;
  margin-top: 12px;
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.05em;
  color: var(--fg-3);
}
.exp-meta span { display: inline-flex; align-items: center; gap: 6px; }

.exp-body { padding: 28px 32px; }
.exp-body p {
  font-size: 0.9375rem;
  color: var(--fg-2);
  line-height: 1.65;
  max-width: 78ch;
  text-wrap: pretty;
}
.exp-body p + p { margin-top: 14px; }

.exp-projects-head {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 16px; flex-wrap: wrap;
  padding: 0 32px 16px;
}
.exp-projects-label {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.09em; text-transform: uppercase;
  color: var(--fg-3);
}
.exp-legend { display: flex; gap: 14px; flex-wrap: wrap; }
.exp-legend span {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 0.75rem;
  color: var(--fg-3);
}
.exp-legend i { width: 7px; height: 7px; border-radius: 50%; }
.exp-legend .dot-fe { background: var(--accent); }
.exp-legend .dot-ux { background: var(--accent-2); }

.exp-projects {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
  gap: 16px;
  padding: 0 32px 32px;
}
.exp-proj {
  display: flex; flex-direction: column; gap: 14px;
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: var(--r);
  background: var(--surface-2);
  transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
}
.exp-proj:hover { border-color: var(--border-strong); transform: translateY(-3px); }
.exp-proj-name {
  font-family: var(--font-display);
  font-size: 0.9375rem; font-weight: 600;
  line-height: 1.3;
}
.exp-proj-note {
  margin-top: -6px;
  font-size: 0.8125rem;
  color: var(--fg-3);
  line-height: 1.5;
}
.exp-discs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
.disc {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 4px 9px;
  border-radius: var(--r-full);
  font-family: var(--font-mono);
  font-size: 0.625rem; font-weight: 500;
  letter-spacing: 0.04em;
}
.disc i { font-size: 0.5625rem; }
.disc--fe {
  color: var(--accent);
  background: var(--accent-soft);
  border: 1px solid var(--accent-line);
}
.disc--ux {
  color: var(--accent-2);
  background: var(--accent-2-soft);
  border: 1px solid var(--accent-2-line);
}

@media (max-width: 640px) {
  .exp-head { flex-direction: column; gap: 16px; padding: 24px; }
  .exp-body { padding: 24px; }
  .exp-projects-head { padding: 0 24px 16px; }
  .exp-projects { padding: 0 24px 24px; grid-template-columns: 1fr; }
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVE
   ═══════════════════════════════════════════════════════════════ */

/* ── ≤1080px — tighten hero, drop stats to 2 cols ───────────── */
@media (max-width: 1080px) {
  .section { padding: 88px 0; }
  .hero-in { gap: 48px; }
  .about-grid { gap: 44px; }
  .contact-grid { gap: 40px; }
  .foot-grid { grid-template-columns: 1fr 1fr; gap: 40px; }
  .foot-brand { grid-column: 1 / -1; }
}

/* ── ≤900px — single-column layouts, mobile nav ─────────────── */
@media (max-width: 900px) {
  .nav-menu {
    position: fixed;
    inset: var(--nav-h) 0 auto;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    padding: 16px;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    transform: translateY(-12px);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.24s var(--ease), opacity 0.24s var(--ease), visibility 0.24s var(--ease);
  }
  .nav-menu.is-open { transform: none; opacity: 1; visibility: visible; }
  .nav-menu a { padding: 13px 14px; font-size: 0.9375rem; }
  .nav-menu a.is-active::after { left: 14px; right: auto; bottom: auto; top: 50%; width: 3px; height: 16px; transform: translateY(-50%); }
  .nav-menu a.is-active { padding-left: 26px; }

  .burger { display: grid; }
  .nav-cta { display: none; }

  .hero { padding: calc(var(--nav-h) + 56px) 0 72px; }
  .hero-in { grid-template-columns: 1fr; gap: 48px; }
  .hero-media { max-width: 380px; }

  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .stat { padding: 32px 20px; }
  .stat:nth-child(odd) { border-left: 0; }
  .stat:nth-child(n + 3) { border-top: 1px solid var(--border); }

  .about-grid { grid-template-columns: 1fr; }
  .contact-grid { grid-template-columns: 1fr; }
}

/* ── ≤640px — phone ────────────────────────────────────────── */
@media (max-width: 640px) {
  .wrap { padding: 0 18px; }
  .section { padding: 72px 0; }
  .sec-head { margin-bottom: 44px; }

  .hero h1 { font-size: clamp(2.25rem, 11vw, 3rem); }
  .hero-actions .btn { flex: 1 1 100%; }

  .socials { flex-wrap: wrap; }

  .pillars { grid-template-columns: 1fr; }
  .panel { padding: 24px; }
  .form { padding: 24px; }
  .field-row { grid-template-columns: 1fr; gap: 0; }
  .field-row .field { margin-bottom: 18px; }

  .proj-grid, .cert-grid, .cards { grid-template-columns: 1fr; }

  .cert { flex-direction: column; gap: 14px; }

  .foot-grid { grid-template-columns: 1fr; gap: 36px; padding: 56px 0 40px; }
  .foot-bottom { flex-direction: column; align-items: flex-start; gap: 12px; }

  #toTop { right: 16px; bottom: 16px; }
}

/* ── ≤420px — small phone ──────────────────────────────────── */
@media (max-width: 420px) {
  .stats-grid { grid-template-columns: 1fr; }
  .stat { border-left: 0; }
  .stat:not(:first-child) { border-top: 1px solid var(--border); }
  .socials-label { display: none; }
}

/* ── PRINT ─────────────────────────────────────────────────── */
@media print {
  .nav, #toTop, .hero::before, .form, .filters { display: none !important; }
  body { background: #fff; color: #000; }
  .section { padding: 24px 0; break-inside: avoid; }
  .reveal, .reveal-group > * { opacity: 1 !important; transform: none !important; }
  a::after { content: ' (' attr(href) ')'; font-size: 0.75em; color: #555; }
}
